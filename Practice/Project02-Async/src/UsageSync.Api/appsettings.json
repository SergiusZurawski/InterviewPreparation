{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Usage": "Server=(localdb)\\MSSQLLocalDB;Database=UsageSync;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Authority": "https://login.example.local/",
    "Audience": "usage-sync-api"
  },
  "Notifications": {
    "WebhookBaseUrl": "https://hooks.example.local/"
  },
  "Sync": {
    "IntervalMinutes": 60,
    "MaxParallelVendors": 4,
    "Vendors": [
      { "VendorId": "vendor-a", "BaseUrl": "https://api.vendor-a.example.local/", "ApiKey": "" },
      { "VendorId": "vendor-b", "BaseUrl": "https://api.vendor-b.example.local/", "ApiKey": "" }
    ]
  }
}
